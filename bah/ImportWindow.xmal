<Window x:Class="EveCorporationDashboard.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Import Data" 
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Instructions -->
        <TextBlock Grid.Row="0" x:Name="InstructionsText" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource ThTextDim}"
                   Text="Navigate to the target page below and log in. Once loaded, click 'Extract Data from Page' to automatically pull the table data."/>

        <!-- URL Navigator -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="UrlTextBox" Width="600" Margin="0,0,10,0" 
                     Text="https://auth.goonfleet.com/manager/groups" /> <!-- Update default URL as needed -->
            <Button Content="Go" Padding="12,5" FontWeight="SemiBold" Click="Navigate_Click"/>
        </StackPanel>

        <!-- Embedded Browser -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource ThBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
            <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="Transparent"/>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="Extract Data from Page" Padding="14,6" FontWeight="SemiBold"
                    Click="ExtractData_Click" Background="{DynamicResource ThAccent}" Foreground="White"/>
            
            <Button Content="Import from clipboard (Fallback)" Padding="14,6" Margin="12,0,0,0"
                    Click="Import_Click"/>
            
            <TextBlock x:Name="ImportStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="450"/>
        </StackPanel>
    </Grid>
</Window>