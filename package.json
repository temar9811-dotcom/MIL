{
  "name": "mrchi-intel-lite",
  "version": "1.2.1",
  "description": "EVE Online Intel Alert Tool",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "start:debug": "set DEBUG=1 & electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "sqlite3": "^6.0.1"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.mrchi.intel-lite",
    "productName": "MRCHI Intel Lite",
    "files": [
      "**/*",
      "!static.db",
      "!dist/",
      "!diag.js",
      "!test-sound.js",
      "!extract-eve-data.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MRCHI Intel Lite"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "temar9811-dotcom",
      "repo": "MIL"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temar9811-dotcom/MIL.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/temar9811-dotcom/MIL/issues"
  },
  "homepage": "https://github.com/temar9811-dotcom/MIL#readme",
  "allowScripts": {
    "electron@35.7.5": true,
    "sqlite3@6.0.1": true,
    "electron-winstaller@5.4.0": true
  }
}